# ==============================================================================
# HITL Content Engine — Backend Environment Configuration Example
# Copy to .env for local testing ONLY. Never commit real secrets to Git.
# In production on Cloud Run, mount secrets via GCP Secret Manager (--set-secrets).
# ==============================================================================

# Gemini API key (originates in Google AI Studio; mounted from Secret Manager in prod)
GOOGLE_API_KEY_ARTICLE=your-rotated-gemini-api-key-here

# High-entropy shared secret (e.g., `openssl rand -hex 32`) shared with Apps Script PropertiesService
WEBHOOK_SHARED_SECRET=replace-with-32-byte-hex-webhook-secret

# Google Drive folder ID containing authorized Agent A-D system prompt Google Docs
# Must be shared with the Cloud Run runtime service account as Viewer
ALLOWED_PROMPT_FOLDER_ID=your-drive-prompt-folder-id

# Optional Gemini model overrides
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash

# Cloud Run HTTP listener port
PORT=8080
